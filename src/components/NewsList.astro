---
import type { CollectionEntry } from 'astro:content';
import { inline, looseDateLabel } from '../lib/pubs';

interface Props {
  items: CollectionEntry<'news'>[];
  layout?: 'columns' | 'list';
}
const { items, layout = 'list' } = Astro.props;
---

<ul class:list={['news', layout]}>
  {
    items.map(({ data }) => (
      <li>
        <time class="mono" datetime={data.date}>{looseDateLabel(data.date)}</time>
        <p>
          <Fragment set:html={inline(data.text)} />
          {data.link && (
            <>
              {' '}
              <a class="more" href={data.link}>More →</a>
            </>
          )}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .news { list-style: none; margin: 0; padding: 0; }
  li { font-size: 16px; }
  p { margin: 0; }
  time { display: block; font-size: 13px; font-weight: 500; color: var(--muted); margin-bottom: 6px; }
  p :global(a) { color: var(--blue); text-underline-offset: 3px; }
  a.more { font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap; }
  a.more:hover { text-decoration: underline; }

  .columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 32px; }
  .columns li { border-top: var(--branch) solid var(--ink); padding: 12px 0 28px; }
  .list li { display: grid; grid-template-columns: 120px 1fr; gap: 4px 24px; padding: 14px 0; border-top: 1px solid var(--rule); }
  .list time { margin: 3px 0 0; }

  @media (max-width: 760px) {
    .columns { grid-template-columns: 1fr; }
    .columns li { padding-bottom: 20px; }
    .list li { grid-template-columns: 1fr; }
  }
</style>
