---
/**
 * The publication record drawn like a time-calibrated range chart: decade
 * "period" cells across the top, one bar per item stacked within its year.
 * Filled = paper/chapter/book/thesis, outlined = conference abstract,
 * blue = selected. Each bar links to its publication page.
 */
import { type Pub, isPaper, plain, pubHref } from '../lib/pubs';

interface Props {
  pubs: Pub[];
  /** Colour these blue (defaults to entries marked `selected`). */
  highlight?: (p: Pub) => boolean;
  legendHighlight?: string;
}
const { pubs, highlight = (p: Pub) => p.data.selected, legendHighlight = 'Selected' } = Astro.props;

const years = pubs.map((p) => p.data.year);
const y0 = Math.floor(Math.min(...years) / 10) * 10;
const y1 = Math.max(new Date().getFullYear(), ...years) + 1; // exclusive
const span = y1 - y0;

const LEVEL = 13;
const level: Record<number, number> = {};
// Oldest first so stacks build upward in reading order; papers sit below abstracts.
const ordered = [...pubs].sort((a, b) => a.data.year - b.data.year || Number(isPaper(b.data)) - Number(isPaper(a.data)));
const bars = ordered.map((p) => {
  const lv = (level[p.data.year] = (level[p.data.year] ?? 0) + 1);
  return { p, lv, kind: highlight(p) ? 'hi' : isPaper(p.data) ? 'paper' : 'abstract' };
});
const maxLevel = Math.max(1, ...Object.values(level));
const H = maxLevel * LEVEL + 10;

const decades: { from: number; to: number; label: string }[] = [];
for (let d = y0; d < y1; d += 10) decades.push({ from: d, to: Math.min(d + 10, y1), label: `${d}s` });
const pct = (yr: number) => ((yr - y0) / span) * 100;
const labels: number[] = [];
for (let yr = y0; yr < y1; yr += 5) labels.push(yr);
---

<figure class="tl" aria-label={`Publication record, ${Math.min(...years)} to ${Math.max(...years)}`}>
  <div class="cells" aria-hidden="true">
    {decades.map((d) => <div style={`flex-grow:${d.to - d.from}`}>{d.label}</div>)}
  </div>
  <svg viewBox={`0 0 ${span} ${H}`} preserveAspectRatio="none" style={`height:${H}px`} role="list">
    {
      Array.from({ length: span }, (_, i) => (
        <line class={(y0 + i) % 5 ? 'tick' : 'grid'} x1={i} x2={i} y1="0" y2={(y0 + i) % 5 ? 5 : H} />
      ))
    }
    {
      bars.map(({ p, lv, kind }) => (
        <a href={pubHref(p.id)} role="listitem">
          <title>{`${p.data.year} · ${plain(p.data.title)}`}</title>
          <rect class={kind} x={p.data.year - y0 + 0.16} width="0.68" y={H - lv * LEVEL} height="9" />
        </a>
      ))
    }
  </svg>
  <div class="years mono" aria-hidden="true">
    {labels.map((yr) => <span style={`left:${pct(yr)}%`}>{yr}</span>)}
  </div>
  <figcaption class="legend">
    <span><i class="paper"></i>Paper, chapter, book, or thesis</span>
    <span><i class="abstract"></i>Conference abstract or talk</span>
    <span><i class="hi"></i>{legendHighlight}</span>
  </figcaption>
</figure>

<style>
  .tl { margin: 0 0 40px; }
  .cells { display: flex; height: 30px; }
  .cells div {
    flex-basis: 0; display: grid; place-items: center; font-size: 14px; font-weight: 600;
    border: 1.5px solid var(--ink); margin-left: -1.5px;
  }
  .cells div:first-child { margin-left: 0; }
  svg { width: 100%; display: block; overflow: visible; }
  line { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  line.grid { stroke: var(--rule); stroke-dasharray: 2 3; }
  rect { stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  rect.paper { fill: var(--ink); stroke: var(--ink); }
  rect.abstract { fill: #fff; stroke: var(--ink); }
  rect.hi { fill: var(--blue); stroke: var(--blue); }
  a:hover rect, a:focus-visible rect { fill: var(--red); stroke: var(--red); }
  .years { position: relative; height: 18px; margin-top: 6px; font-size: 11px; color: var(--faint); }
  .years span { position: absolute; transform: translateX(3px); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 13px; color: var(--muted); margin-top: 8px; }
  .legend i { display: inline-block; width: 14px; height: 9px; margin-right: 7px; vertical-align: -1px; border: 1.5px solid var(--ink); }
  .legend i.paper { background: var(--ink); }
  .legend i.hi { background: var(--blue); border-color: var(--blue); }
  @media (max-width: 600px) {
    .cells div { font-size: 12px; }
    .years span:nth-child(even) { display: none; }
  }
</style>
