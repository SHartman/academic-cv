---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import portrait from '../assets/portrait.jpg';

const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---

<Base title="About" description={`About ${site.name}: ${site.descriptor}, ${site.position}, ${site.department}, ${site.institution}.`}>
  <header class="page-head">
    <h1>About</h1>
  </header>
  <div class="about">
    <aside>
      <Image src={portrait} alt={`Portrait of ${site.name}`} widths={[320, 640]} sizes="(max-width: 800px) 60vw, 300px" />
      <dl>
        <dt>Position</dt>
        <dd>{site.position}<br />{site.department}<br />{site.institution}</dd>
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        <dt>Elsewhere</dt>
        <dd class="links">
          {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={site.outreachSite}>Skeletal Drawing</a>
        </dd>
      </dl>
    </aside>
    <div class="prose"><Content /></div>
  </div>
</Base>

<style>
  .about { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 64px; align-items: start; }
  aside :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border: 1px solid var(--rule); }
  dl { margin: 24px 0 0; display: grid; gap: 4px; }
  dt { font-size: 12.5px; font-weight: 600; color: var(--faint); margin-top: 14px; }
  dd { margin: 0; font-size: 15px; line-height: 1.5; }
  dd a { color: var(--blue); text-underline-offset: 3px; }
  .links { display: flex; flex-direction: column; gap: 2px; }

  /* Dated lists (education, grants): "- **2020** Text" → a mono year column with hanging indent. */
  .prose :global(ul:has(> li > strong:first-child)) { list-style: none; padding-left: 0; }
  .prose :global(li:has(> strong:first-child)) { padding-left: 5.4em; text-indent: -5.4em; }
  .prose :global(li:has(> strong:first-child) > strong:first-child) {
    /* minus ~one space, so first and wrapped lines align */
    display: inline-block; width: calc((5.4em - 0.26em) / 0.82); text-indent: 0;
    font-family: var(--mono); font-size: 0.82em; font-weight: 500; color: var(--blue);
  }
  @media (max-width: 800px) {
    .about { grid-template-columns: 1fr; gap: 40px; }
    aside { display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: start; }
    dl { margin: 0; }
    dt:first-child { margin-top: 0; }
  }
</style>
