// Cloudflare deployment: a static-assets-only Worker serving the Astro build in dist/.
// `name` must match the project name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academic-cv",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (with a 404 status) for unknown URLs.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
